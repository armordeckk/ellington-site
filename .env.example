# ------------------------------------------------------------------
# Ellington Properties — variables d'environnement
# Copier ce fichier en « .env.local » et remplir les valeurs.
# NE JAMAIS committer .env.local (déjà dans .gitignore).
# Sur Vercel : Project → Settings → Environment Variables.
# ------------------------------------------------------------------

# --- Apimo (les biens immobiliers) ---
# Apimo back-office → Réglages → API
# Si une seule de ces 3 est vide, le site bascule sur des biens de démo.
APIMO_PROVIDER=
APIMO_TOKEN=
APIMO_AGENCY=

# --- Supabase (connexion + favoris) ---
# Supabase dashboard → Project Settings → API
#   URL               = « Project URL »
#   PUBLISHABLE_KEY   = clé « publishable » / « anon public »
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- URL publique du site ---
# Utilisée pour les liens dans les emails d'inscription et le SEO.
# En prod : https://www.ellingtoninternational.com
NEXT_PUBLIC_SITE_URL=https://www.ellingtoninternational.com
